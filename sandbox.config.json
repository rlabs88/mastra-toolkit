{
  "$schema": "./config/sandbox.schema.json",
  "apiVersion": "cortex.provisioning/v1",
  "kind": "SandboxRuntime",
  "metadata": {
    "id": "mastra-toolkit",
    "displayName": "Mastra Toolkit",
    "version": 1
  },
  "spec": {
    "defaultProvider": "local",
    "commandTimeoutMs": 300000,
    "maxSandboxes": 8,
    "workdir": "/workspace",
    "entrypointProfile": {
      "id": "aes-sandbox-arm64-v1",
      "image": "ghcr.io/rlabs88/toolkit/aes-sandbox@sha256:8965a9f6d38494d90e717e72f3283c7b47c82368ebe390c49c604c718023bda0",
      "platform": "linux/arm64",
      "abi": "sandbox-entrypoint/v1",
      "command": ["serve"],
      "probeCommand": ["probe"]
    },
    "local": {
      "isolation": "auto",
      "allowNetwork": true,
      "allowSystemBinaries": true,
      "readOnly": false,
      "readOnlyPaths": [],
      "readWritePaths": ["/dev/null"]
    },
    "docker": {
      "readonlyRootfs": true,
      "capDrop": ["ALL"],
      "securityOpt": ["no-new-privileges:true"],
      "pidsLimit": 512,
      "memoryBytes": 4294967296,
      "tmpfs": {
        "/tmp": "rw,noexec,nosuid,size=512m",
        "/run": "rw,noexec,nosuid,size=64m"
      }
    },
    "platform": {
      "networkIsolation": "PRIVATE",
      "idleTimeoutMinutes": 120
    }
  }
}
