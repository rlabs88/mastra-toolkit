{
  "name": "mastra-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "RLabs local Mastra agent runtime and Mastra Factory adapter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rlabs88/mastra-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/rlabs88/mastra-toolkit/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "mastra dev --dir apps/studio/src",
    "dev:infisical": "node scripts/with-infisical.mjs env PROXY_MODEL=code-frontier-high npm run dev",
    "dev:factory": "MASTRA_TOOLKIT_MODE=factory mastra factory dev --dir apps/factory/src",
    "dev:factory:infisical": "node scripts/with-infisical.mjs env MASTRA_TOOLKIT_MODE=factory PROXY_MODEL=code-frontier-high npm run dev:factory",
    "code": "mcode",
    "mz": "mz",
    "code:infisical": "node scripts/with-infisical.mjs env PROXY_MODEL=code-frontier-high npm run code",
    "build": "mastra build --dir apps/studio/src",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "vendor:verify": "node scripts/verify-vendored-dependencies.mjs",
    "secrets:check": "node scripts/with-infisical.mjs node scripts/check-env.mjs",
    "secrets:check:factory": "node scripts/with-infisical.mjs env MASTRA_TOOLKIT_MODE=factory node scripts/check-env.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.20",
    "@mastra/auth-workos": "1.6.4",
    "@mastra/client-js": "file:vendor/mastra/mastra-client-js-1.39.0-rlabs.mz.3.tgz",
    "@mastra/code-sdk": "file:vendor/mastra/mastra-code-sdk-1.2.0-rlabs.mz.2.tgz",
    "@mastra/core": "file:vendor/mastra/mastra-core-1.58.0-rlabs.mz.2.tgz",
    "@mastra/deployer": "file:vendor/mastra/mastra-deployer-1.58.0-alpha.8-rlabs.mz.4.tgz",
    "@mastra/docker": "0.5.0",
    "@mastra/factory": "file:vendor/mastra/mastra-factory-0.5.0-rlabs.mz.2.tgz",
    "@mastra/hono": "file:vendor/mastra/mastra-hono-1.6.0-alpha.8-rlabs.mz.2.tgz",
    "@mastra/libsql": "1.19.0",
    "@mastra/memory": "1.26.1-alpha.3",
    "@mastra/observability": "file:vendor/mastra/mastra-observability-1.16.6-rlabs.mz.2.tgz",
    "@mastra/pg": "1.19.0",
    "@mastra/platform-workspace": "0.2.3",
    "@mastra/redis-streams": "0.3.0",
    "@mastra/stagehand": "0.3.1",
    "@mastra/server": "file:vendor/mastra/mastra-server-1.58.0-rlabs.mz.3.tgz",
    "esbuild": "0.28.1",
    "mastracode": "file:vendor/mastra/mastracode-0.33.0-rlabs.mz.5.tgz",
    "yaml": "2.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "mastra": "1.23.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@mastra/memory": "1.26.1-alpha.3",
    "@mastra/deployer": "$@mastra/deployer",
    "@mastra/server": "$@mastra/server"
  }
}
