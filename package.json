{
  "name": "mastra-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "RLabs local Mastra agent runtime and Mastra Factory adapter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rlabs88/mastra-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/rlabs88/mastra-toolkit/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "mastra dev --dir apps/studio/src",
    "dev:infisical": "node scripts/with-infisical.mjs npm run dev",
    "dev:factory": "MASTRA_TOOLKIT_MODE=factory mastra factory dev --dir apps/factory/src",
    "dev:factory:infisical": "node scripts/with-infisical.mjs env MASTRA_TOOLKIT_MODE=factory npm run dev:factory",
    "code": "mcode",
    "code:infisical": "node scripts/with-infisical.mjs env PROXY_MODEL=code-frontier-high npm run code",
    "build": "mastra build --dir apps/studio/src",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "secrets:check": "node scripts/with-infisical.mjs node scripts/check-env.mjs",
    "secrets:check:factory": "node scripts/with-infisical.mjs env MASTRA_TOOLKIT_MODE=factory node scripts/check-env.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.20",
    "@mastra/auth-workos": "1.6.4",
    "@mastra/code-sdk": "1.1.1",
    "@mastra/core": "1.55.0",
    "@mastra/docker": "0.5.0",
    "@mastra/factory": "0.3.0",
    "@mastra/libsql": "1.18.0",
    "@mastra/memory": "1.24.0",
    "@mastra/pg": "1.18.1",
    "@mastra/platform-workspace": "0.2.3",
    "@mastra/redis-streams": "0.3.0",
    "@mastra/stagehand": "0.3.1",
    "esbuild": "0.28.1",
    "mastracode": "0.32.4",
    "yaml": "2.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "mastra": "1.21.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
